{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.staging)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(.env.staging)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(head .env*)",
      "Bash(head **/.env*)",
      "Bash(tail .env*)",
      "Bash(tail **/.env*)",
      "Bash(less .env*)",
      "Bash(less **/.env*)",
      "Bash(more .env*)",
      "Bash(more **/.env*)",
      "Bash(type .env*)",
      "Bash(printenv)",
      "Bash(env)"
    ]
  }
}
